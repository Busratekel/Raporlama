{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BoytasWH": "Server=YOUR_DB_SERVER;Database=BoytasWH;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;",
    "BellonaRapor": "Server=YOUR_DB_SERVER;Database=BellonaRapor;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "Cache": {
    "Enabled": true,
    "DefaultDuration": 5
  },
  "PortalAuth": {
    "SsoValidationMode": "Signed",
    "PortalLoginUrl": "https://portal.bellona.com.tr",
    "SsoApiKey": "CHANGE_ME",
    "Issuer": "BellonaPortal",
    "Audience": "Raporlama.API",
    "UserNameDomain": "BELLONAAS"
  },
  "LocalAuth": {
    "Enabled": true,
    "AdDomain": "BELLONAAS",
    "OtpExpirySeconds": 90,
    "OtpMaxAttempts": 3,
    "OtpMaxResends": 3,
    "OtpResendCooldownSeconds": 30,
    "OtpResendSessionMinutes": 10,
    "LogOtpInDevelopment": true,
    "AllowSelfSicilRegistration": true,
    "EmployeePhoneDatabase": "eBA6",
    "EmployeePhoneTable": "TWOF_CEPTEL",
    "TrustedDeviceEnabled": true,
    "TrustedDeviceDays": 7
  },
  "Sms": {
    "Provider": "DevLog",
    "ApiUrl": "http://service2.turatel.com.tr/xml/process.aspx",
    "UserCode": "TURATEL_USER",
    "Password": "TURATEL_PASSWORD",
    "Sender": "BELLONA",
    "ChannelCode": "583",
    "PlatformId": "1",
    "OtpMessageTemplate": "Bellona Raporlama giris kodunuz: {0}. {1} gecerlidir."
  },
  "Authorization": {
    "AdminAdGroups": [ "Raporlama-Admins" ],
    "AdDomain": "BELLONAAS",
    "AdminUsers": [
      "busra.tekel",
      "BELLONA\\busra.tekel"
    ]
  },
  "ETL": {
    "LogDirectory": "C:\\Services\\Raporlama.ETL\\logs",
    "ServiceUrl": "http://127.0.0.1:5010"
  },
  "Push": {
    "Enabled": false,
    "Subject": "mailto:it@bellona.com.tr",
    "VapidPublicKey": "CHANGE_ME_PUBLIC",
    "VapidPrivateKey": "CHANGE_ME_PRIVATE"
  }
}
